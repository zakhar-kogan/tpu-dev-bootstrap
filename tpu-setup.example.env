# TPU Dev Bootstrap configuration.
# CLI flags override these values. Source this file or pass via --config.

PYTHON_VERSION=3.10
ENV_NAME=tpu-dev
ENV_BASE=~/.local/share/tpu-dev/envs

JUPYTER_PORT=8888
PUBLIC_JUPYTER=yes
ENABLE_JUPYTER=yes

ENABLE_MARIMO=no
MARIMO_PORT=2718

CLOUDFLARE_TUNNEL=no

PACKAGE_GROUPS=core,tpu,general-ds,graphs,nlp,cayley-graphs

# Keep these aligned unless you know the TPU image/runtime needs another pair.
TORCH_VERSION=2.9.0
TORCH_XLA_VERSION=2.9.0

# Comma-separated list of extra pip packages.
EXTRA_PIP=
